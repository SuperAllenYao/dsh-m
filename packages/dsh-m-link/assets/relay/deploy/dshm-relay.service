# DSH-m relay — systemd unit (M2a)
#
# Install: see deploy/install.sh. Layout assumed:
#   /usr/local/bin/dshm-relay
#   /etc/dshm-relay/relay.yaml
#   /var/lib/dshm-relay/{relay.secret,state.json,audit.jsonl,tls/{cert.pem,key.pem}}
#
# The relay binds 443 without root via CAP_NET_BIND_SERVICE only.
# SIGTERM triggers the drain path: tunnels receive {"t":"drain"}, bridge listeners
# close, state.json is retained, then the process exits 0.

[Unit]
Description=DSH-m transparent relay (M2a)
Documentation=file:///usr/local/share/doc/dshm-relay/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dshm-relay
Group=dshm-relay
WorkingDirectory=/var/lib/dshm-relay
ExecStart=/usr/local/bin/dshm-relay serve --config /etc/dshm-relay/relay.yaml --log-level info
Restart=always
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=15s

# Bind 443 as an unprivileged user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Hardening: only the data directory is writable.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/dshm-relay

LimitNOFILE=65536
# Target is <50MB idle; MemoryHigh only throttles if the relay ever misbehaves.
MemoryHigh=64M

[Install]
WantedBy=multi-user.target
